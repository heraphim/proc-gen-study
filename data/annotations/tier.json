{
  "_about": "Three-layer classification of every catalogue entry. Applied by scripts/migrate.js.",
  "_tiers": {
    "source": "Makes structure from a seed and parameters alone. No input representation.",
    "operator": "Transforms one representation into another. Describable without naming the artefact.",
    "generator": "A named artefact. Describing it requires saying what it is for."
